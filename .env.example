# ============================================================
# Wetrace Pro 配置模板
# 复制此文件为 .env，按注释填写后启动程序
# .env 中的密钥由程序自动提取并写入，首次部署只需填写路径
# ============================================================

# ── 服务监听 ────────────────────────────────────────────────
# ⚠️ 默认只监听本机。别随手改成 0.0.0.0 ——
# 没设 PASSWORD_HASH 且没有移动端配对时，鉴权中间件是**完全放行**的
# （web/middleware/auth.go），绑到 0.0.0.0 等于把解密后的全部聊天记录
# 零凭据挂到局域网上，同一 WiFi 下任何人都能看。
LISTEN_ADDR=127.0.0.1:5200

# 确实要让手机/其他设备访问时，先在设置页设好密码或生成移动端配对，
# 再改成下面这行（或换成本机的 Tailscale IP，比暴露到整个局域网安全）：
# LISTEN_ADDR=0.0.0.0:5200

# ── 取密钥用的 DLL（仅 Windows）────────────────────────────
# wx_key.dll **不随仓库分发**（.gitignore 排除了 *.dll，git 历史中从未有过），
# 程序也不会生成它。全新 clone 后 Windows 的「获取密钥」必然失败，
# 需要自行准备该 DLL 并在此指定路径；留空则按 wxkey/wx_key.dll 查找。
WXKEY_DLL_PATH=

# ── 微信路径（必填）────────────────────────────────────────
# 微信可执行文件路径，例如：C:\Program Files\Tencent\Weixin\Weixin.exe
WXKEY_WECHAT_PATH=

# 微信数据目录（xwechat_files 下对应用户的文件夹），例如：
# C:\Users\YourName\Documents\xwechat_files\wxid_xxxx
WECHAT_DB_SRC_PATH=

# ── 微信加密密钥（由程序自动提取，无需手动填写）────────────
WECHAT_DB_KEY=
IMAGE_KEY=
XOR_KEY=

# ── AI 功能（可选）─────────────────────────────────────────
AI_ENABLED=false
# 支持：deepseek / openai / ollama / moonshot / qwen / zhipu / anthropic
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=

# ── 语音转文字（可选）──────────────────────────────────────
TTS_ENABLED=false
TTS_LOCAL_MODE=true
# Whisper 可执行文件路径
TTS_LOCAL_BINARY=
# Whisper 模型文件路径（如 ggml-medium.bin）
TTS_LOCAL_MODEL=
TTS_PROVIDER=openai
TTS_BASE_URL=
TTS_MODEL=whisper-1

# ── 统计基准年份（用于年度报告对比）────────────────────────
EFFECTIVE_CHAT_START_YEAR=2023

# ── 合规确认（首次启动后程序自动写入，无需手动填写）────────
COMPLIANCE_AGREED=false
COMPLIANCE_AGREED_AT=
COMPLIANCE_VERSION=1.0
