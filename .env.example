# Wetrace Plus 配置模板
# 复制为 .env 后按需修改。导入功能不需要微信路径或任何解密密钥。

# 默认只允许本机访问。
LISTEN_ADDR=127.0.0.1:5200

# 统一分析库目录。
WORK_DIR=data

# 如需让手机或其他设备访问，请先在设置页启用密码或创建移动端配对，
# 再按实际网络环境修改监听地址。没有凭据的远程请求会被拒绝。
# LISTEN_ADDR=0.0.0.0:5200

# 通过域名访问时（如 Tailscale MagicDNS），把域名列在这里，逗号分隔。
# 直接用 IP 或 localhost 访问不需要配置；其余域名一律拒绝（防 DNS 重绑定）。
# ALLOWED_HOSTS=my-mac.tail1234.ts.net

# AI 分析（可选；启用在线服务时，所选聊天内容会发送到该服务商）
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=

# 语音转文字（可选）
TTS_ENABLED=false
TTS_LOCAL_MODE=true
TTS_LOCAL_BINARY=
TTS_LOCAL_MODEL=
TTS_PROVIDER=openai
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=whisper-1

# 统计设置
EFFECTIVE_CHAT_START_YEAR=2023

# 首次启动后由程序记录
COMPLIANCE_AGREED=false
COMPLIANCE_AGREED_AT=
COMPLIANCE_VERSION=1.0
